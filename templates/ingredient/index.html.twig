{% extends 'base.html.twig' %}

{% block title %}Gestion des ingrédients{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des ingrédients</h1>
        <a href="{{ path('app_ingredient_new') }}" class="btn btn-primary">
            + Ajouter un ingrédient
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% if ingredients is empty %}
        <div class="alert alert-info">
            Aucun ingrédient enregistré.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Unité</th>
                        <th>Stock actuel</th>
                        <th>Seuil d'alerte</th>
                        <th>État du stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ingredient in ingredients %}
                        <tr>
                            <td>{{ ingredient.name }}</td>
                            <td>{{ ingredient.unit }}</td>
                            <td>{{ ingredient.stockQuantity }}</td>
                            <td>{{ ingredient.alertThreshold }}</td>
                            <td>
                                {% if ingredient.stockQuantity <= ingredient.alertThreshold %}
                                    <span class="badge bg-danger">Stock faible</span>
                                {% else %}
                                    <span class="badge bg-success">Disponible</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_ingredient_edit', {id: ingredient.id}) }}"
                                   class="btn btn-warning btn-sm">
                                    Modifier
                                </a>

                                <form method="post"
                                      action="{{ path('app_ingredient_delete', {id: ingredient.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Voulez-vous vraiment supprimer cet ingrédient ?');">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete' ~ ingredient.id) }}">
                                    <button class="btn btn-danger btn-sm">
                                        Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
