{% extends 'base.html.twig' %}

{% block title %}Gestion des achats{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des achats</h1>

        <a href="{{ path('app_purchase_new') }}" class="btn btn-primary">
            + Enregistrer un achat
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% if purchases is empty %}
        <div class="alert alert-info">
            Aucun achat enregistré pour le moment.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Fournisseur</th>
                        <th>Date d'achat</th>
                        <th>Référence</th>
                        <th>Nombre d'articles</th>
                        <th>Montant total</th>
                    </tr>
                </thead>

                <tbody>
                    {% for purchase in purchases %}
                        <tr>
                            <td>{{ purchase.id }}</td>
                            <td>{{ purchase.supplierName }}</td>
                            <td>{{ purchase.purchaseDate|date('d/m/Y H:i') }}</td>
                            <td>{{ purchase.reference ?? '-' }}</td>
                            <td>{{ purchase.purchaseItems|length }}</td>
                            <td>{{ purchase.totalAmount }} DH</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <a href="{{ path('app_ingredient_index') }}" class="btn btn-secondary">
        Retour aux ingrédients
    </a>

</div>
{% endblock %}
