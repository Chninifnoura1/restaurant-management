{% extends 'base.html.twig' %}

{% block title %}Enregistrer un achat{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Enregistrer un achat</h3>
                </div>

                <div class="card-body">
                    {% for message in app.flashes('danger') %}
                        <div class="alert alert-danger">{{ message }}</div>
                    {% endfor %}

                    {{ form_start(form) }}

                    {{ form_row(form.supplierName) }}
                    {{ form_row(form.purchaseDate) }}
                    {{ form_row(form.reference) }}

                    <hr>

                    <h5>Ingrédients achetés</h5>

                    <div
                        id="purchase-items"
                        data-index="{{ form.purchaseItems|length }}"
                        data-prototype="{{ form_widget(form.purchaseItems.vars.prototype)|e('html_attr') }}"
                    >
                        {{ form_widget(form.purchaseItems) }}
                    </div>

                    <button type="button" id="add-item" class="btn btn-outline-primary btn-sm mt-2">
                        + Ajouter un ingrédient
                    </button>

                    <hr>

                    <button type="submit" class="btn btn-success">
                        Enregistrer l'achat
                    </button>

                    <a href="{{ path('app_purchase_index') }}" class="btn btn-secondary">
                        Annuler
                    </a>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('purchase-items');
    const addButton = document.getElementById('add-item');

    function addRemoveButton(item) {
        if (item.querySelector('.remove-item')) {
            return;
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'btn btn-outline-danger btn-sm mt-2 mb-3 remove-item';
        button.textContent = 'Supprimer cette ligne';

        button.addEventListener('click', function () {
            item.remove();
        });

        item.appendChild(button);
    }

    Array.from(container.children).forEach(addRemoveButton);

    addButton.addEventListener('click', function () {
        const index = Number(container.dataset.index);
        const html = container.dataset.prototype.replace(/__name__/g, index);

        container.dataset.index = index + 1;

        const wrapper = document.createElement('div');
        wrapper.className = 'border rounded p-3 mb-3 purchase-item';
        wrapper.innerHTML = html;

        container.appendChild(wrapper);
        addRemoveButton(wrapper);
    });
});
</script>
{% endblock %}
