<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion - Restaurant Management</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            color: #172033;
        }
        .login-card {
            width:  min(420px, calc(100% - 32px));
            padding: 35px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(20, 40, 80, .10);
        }
        h1 { margin: 0 0 8px; font-size: 25px; }
        p { color: #64748b; margin-bottom: 25px; }
        label { display: block; margin: 16px 0 7px; font-weight: 600; }
        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #dbe2ea;
            border-radius: 8px;
            font-size: 15px;
        }
        button {
            width: 100%;
            margin-top: 24px;
            padding: 13px;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }
        .error {
            padding: 12px;
            color: #991b1b;
            background: #fee2e2;
            border-radius: 8px;
        }
    </style>
</head>
<body>
<div class="login-card">
    <h1>Restaurant Management</h1>
    <p>Connectez-vous à votre espace de gestion.</p>

    {% if error %}
        <div class="error">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <label for="email">Adresse email</label>
        <input
            type="email"
            id="email"
            name="email"
            value="{{ last_username }}"
            autocomplete="email"
            required
            autofocus
        >

        <label for="password">Mot de passe</label>
        <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
        >

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Se connecter</button>
    </form>
</div>
</body>
</html>