{% extends 'base.html.twig' %}

{% block title %}Écran Cuisine{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Écran Cuisine</h1>

        <a href="{{ path('app_order') }}" class="btn btn-outline-secondary">
            Retour aux commandes
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% if orders is empty %}
        <div class="alert alert-info">
            Aucune commande en attente ou en préparation.
        </div>
    {% else %}
        <div class="row">
            {% for order in orders %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">

                        <div class="card-header d-flex justify-content-between">
                            <strong>Commande #{{ order.id }}</strong>

                            {% if order.status == 'pending' %}
                                <span class="badge bg-secondary">En attente</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">
                                    En préparation
                                </span>
                            {% endif %}
                        </div>

                        <div class="card-body">
                            <h5 class="card-title">
                                Table {{ order.tableNumber ?? '-' }}
                            </h5>

                            <p class="text-muted">
                                {{ order.createdAt|date('d/m/Y H:i') }}
                            </p>

                            <hr>

                            <h6>Plats à préparer :</h6>

                            <ul class="list-group list-group-flush mb-3">
                                {% for item in order.items %}
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>{{ item.dish.name }}</span>
                                        <strong>× {{ item.quantity }}</strong>
                                    </li>
                                {% endfor %}
                            </ul>

                            {% if order.status == 'pending' %}
                                <form method="post"
                                      action="{{ path('app_order_prepare', {id: order.id}) }}">

                                    <input type="hidden"
                                           name="_token"
                                           value="{{ csrf_token('prepare-order-' ~ order.id) }}">

                                    <button type="submit" class="btn btn-warning w-100">
                                        Commencer la préparation
                                    </button>
                                </form>
                            {% else %}
                                <div class="alert alert-warning mb-0">
                                    Cette commande est en cours de préparation.
                                </div>
                            {% endif %}
                        </div>

                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}
