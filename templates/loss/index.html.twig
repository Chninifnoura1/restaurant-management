{% extends 'base.html.twig' %}

{% block title %}Gestion des pertes{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestion des pertes</h1>
            <p class="text-muted mb-0">
                Historique des ingrédients perdus et des quantités retirées du stock.
            </p>
        </div>

        <a href="{{ path('app_loss_new') }}" class="btn btn-primary">
            + Enregistrer une perte
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            {% if losses is not empty %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                <th>Ingrédient</th>
                                <th>Quantité perdue</th>
                                <th>Motif</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for loss in losses %}
                                <tr>
                                    <td>
                                        {{ loss.createdAt ? loss.createdAt|date('d/m/Y H:i') : '-' }}
                                    </td>
                                    <td>{{ loss.ingredient.name }}</td>
                                    <td>
                                        {{ loss.quantity }}
                                        {{ loss.ingredient.unit }}
                                    </td>
                                    <td>{{ loss.reason }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <p class="text-muted mb-3">Aucune perte enregistrée.</p>
                    <a href="{{ path('app_loss_new') }}" class="btn btn-outline-primary">
                        Enregistrer la première perte
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <a href="{{ path('app_ingredient_index') }}" class="btn btn-outline-secondary mt-3">
        Retour aux ingrédients
    </a>
</div>
{% endblock %}
