<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Restaurant Management{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #0f766e;
            --primary-light: #e6f4f1;
            --sidebar: #172b3a;
            --sidebar-hover: #263f50;
            --body-bg: #f5f7fa;
            --text-dark: #243447;
            --text-muted: #8492a6;
            --border: #e9edf2;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--body-bg);
            color: var(--text-dark);
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            font-size: 14px;
        }

        .app-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 255px;
            background: var(--sidebar);
            color: white;
            padding: 25px 17px;
            overflow-y: auto;
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 10px 30px;
            border-bottom: 1px solid rgba(255,255,255,.1);
            margin-bottom: 25px;
        }

        .brand-icon {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .brand-name {
            font-size: 16px;
            font-weight: 700;
            margin: 0;
        }

        .brand-subtitle {
            color: #9aabba;
            font-size: 11px;
            margin-top: 3px;
        }

        .sidebar-label {
            color: #8295a5;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.3px;
            padding: 0 12px;
            margin: 22px 0 10px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px 13px;
            margin: 4px 0;
            border-radius: 9px;
            color: #c0ccd6;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: .2s;
        }

        .sidebar-link i {
            font-size: 17px;
        }

        .sidebar-link:hover {
            background: var(--sidebar-hover);
            color: white;
        }

        .sidebar-link.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 5px 15px rgba(15,118,110,.25);
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,.1);
            margin-top: 30px;
            padding: 18px 10px 0;
            color: #91a3b2;
            font-size: 11px;
        }

        .main-area {
            margin-left: 255px;
            min-height: 100vh;
        }

        .topbar {
            height: 75px;
            background: white;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
        }

        .topbar-title {
            font-size: 13px;
            color: var(--text-muted);
        }

        .topbar-title strong {
            display: block;
            font-size: 17px;
            color: var(--text-dark);
            margin-top: 3px;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .content-area {
            padding: 30px 35px;
            max-width: 1600px;
            margin: auto;
        }

        /* General components */

        .card {
            border: 1px solid var(--border);
            border-radius: 13px;
            box-shadow: 0 3px 12px rgba(30,50,70,.035);
        }

        .card-header {
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 17px 20px;
            font-weight: 700;
        }

        .card-body {
            padding: 20px;
        }

        .btn {
            border-radius: 8px;
            padding: 9px 16px;
            font-weight: 600;
            font-size: 13px;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: #115e59;
            border-color: #115e59;
        }

        .form-control,
        .form-select {
            border: 1px solid #dce3ea;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 13px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(15,118,110,.10);
        }

        label {
            font-weight: 600;
            margin-bottom: 7px;
            color: #435366;
        }

        .table {
            vertical-align: middle;
            font-size: 13px;
        }

        .table thead th {
            background: #f7f9fb;
            color: #718096;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-weight: 700;
            padding: 14px;
            border-bottom: 1px solid var(--border);
        }

        .table tbody td {
            padding: 14px;
            border-color: var(--border);
        }

        .table tbody tr:hover {
            background: #f9fbfc;
        }

        .alert {
            border-radius: 10px;
            border: none;
        }

        h1, h2, h3, h4, h5 {
            color: var(--text-dark);
            font-weight: 700;
        }

        a {
            transition: .2s;
        }

        @media (max-width: 768px) {
            .app-sidebar {
                position: relative;
                width: 100%;
                height: auto;
                bottom: auto;
                padding: 15px;
            }

            .brand {
                padding-bottom: 15px;
                margin-bottom: 12px;
            }

            .sidebar-label,
            .sidebar-footer {
                display: none;
            }

            .sidebar-link {
                display: inline-flex;
                margin: 3px;
                padding: 9px;
            }

            .main-area {
                margin-left: 0;
            }

            .topbar {
                padding: 0 16px;
                height: 65px;
            }

            .content-area {
                padding: 20px 14px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
<style id="restaurant-global-design">
/* Global administration design */
body {
    background: #f5f7fb;
    color: #172033;
}

main, .main-content {
    min-width: 0;
}

.container.mt-4,
.container.py-4,
.container.py-5,
.container.mt-4.mb-5,
.container-fluid {
    padding-top: 28px !important;
    padding-bottom: 28px !important;
}

h1 {
    font-size: 27px;
    font-weight: 750;
    color: #172033;
}

h2, h3, h4, h5, h6 {
    color: #172033;
    font-weight: 700;
}

p.text-muted {
    color: #7b8495 !important;
}

.card {
    border: 1px solid #e8edf3;
    border-radius: 13px;
    box-shadow: 0 4px 15px rgba(15,23,42,.045);
    overflow: hidden;
}

.card-header {
    background: #fff;
    border-bottom: 1px solid #edf0f5;
    padding: 17px 21px;
    font-weight: 700;
}

.card-header.bg-primary {
    background: #2563eb !important;
    color: white !important;
}

.card-header.bg-dark {
    background: #172033 !important;
    color: white !important;
}

.card-body {
    padding: 22px;
}

.table-responsive {
    border-radius: 9px;
}

.table {
    margin-bottom: 0;
    vertical-align: middle;
}

.table thead th {
    background: #f8fafc;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .3px;
    padding: 14px 15px;
    border-bottom: 1px solid #e8edf3;
    white-space: nowrap;
}

.table tbody td {
    padding: 14px 15px;
    border-color: #edf0f5;
    font-size: 14px;
}

.table tbody tr:hover {
    background: #f8fafc;
}

.table-dark th {
    background: #172033 !important;
    color: white !important;
}

.form-label,
label {
    color: #475569;
    font-size: 13px;
    font-weight: 600;
}

.form-control,
.form-select {
    border: 1px solid #dfe5ed;
    border-radius: 8px;
    padding: 10px 12px;
    min-height: 42px;
    font-size: 14px;
}

.form-control:focus,
.form-select:focus {
    border-color: #93b4f5;
    box-shadow: 0 0 0 3px rgba(37,99,235,.10);
}

textarea.form-control {
    min-height: 100px;
}

.btn {
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    padding: 9px 15px;
}

.btn-primary {
    background: #2563eb;
    border-color: #2563eb;
}

.btn-primary:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
}

.btn-success {
    background: #16a34a;
    border-color: #16a34a;
}

.btn-warning {
    color: #713f12;
}

.btn-danger {
    background: #dc2626;
    border-color: #dc2626;
}

.btn-secondary,
.btn-outline-secondary {
    border-radius: 8px;
}

.badge {
    border-radius: 20px;
    padding: 6px 10px;
    font-weight: 600;
}

.alert {
    border: none;
    border-radius: 9px;
    padding: 14px 17px;
    font-size: 14px;
}

.list-group-item {
    border-color: #edf0f5;
    padding: 13px 15px;
}

hr {
    border-color: #e8edf3;
    opacity: 1;
}

@media (max-width: 768px) {
    h1 {
        font-size: 22px;
    }

    .card-body {
        padding: 16px;
    }

    .table {
        min-width: 650px;
    }

    .container.mt-4,
    .container.py-4,
    .container.py-5 {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }
}
</style>
</head>

<body>

<aside class="app-sidebar">

    <div class="brand">
        <div class="brand-icon">
            <i class="bi bi-shop"></i>
        </div>

        <div>
            <p class="brand-name">RestaurantPro</p>
            <div class="brand-subtitle">Management System</div>
        </div>
    </div>

    <div class="sidebar-label">MENU PRINCIPAL</div>

    <nav>
        <a href="{{ path('app_dashboard') }}"
           class="sidebar-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
            <i class="bi bi-grid-1x2"></i>
            Dashboard
        </a>

        <a href="{{ path('app_dish_index') }}"
           class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_dish' ? 'active' : '' }}">
            <i class="bi bi-egg-fried"></i>
            Plats et recettes
        </a>

        <a href="{{ path('app_ingredient_index') }}"
           class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_ingredient' ? 'active' : '' }}">
            <i class="bi bi-box-seam"></i>
            Ingrédients
        </a>

        <a href="{{ path('app_order') }}"
           class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_order' ? 'active' : '' }}">
            <i class="bi bi-receipt"></i>
            Commandes
        </a>

        <a href="{{ path('app_order_kitchen') }}"
           class="sidebar-link">
            <i class="bi bi-fire"></i>
            Écran cuisine
        </a>
    </nav>

    <div class="sidebar-label">GESTION DU STOCK</div>

    <nav>
        <a href="{{ path('app_purchase_index') }}"
           class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_purchase' ? 'active' : '' }}">
            <i class="bi bi-cart-plus"></i>
            Achats
        </a>

        <a href="{{ path('app_loss_index') }}"
           class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_loss' ? 'active' : '' }}">
            <i class="bi bi-trash3"></i>
            Pertes
        </a>

        <a href="{{ path('app_inventory_index') }}"
           class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_inventory' ? 'active' : '' }}">
            <i class="bi bi-clipboard-check"></i>
            Inventaire
        </a>
    </nav>

    <div class="sidebar-footer">
        <i class="bi bi-shield-check me-1"></i>
        Restaurant Management v1.0
    </div>

</aside>

<div class="main-area">

    <header class="topbar">

        <div class="topbar-title">
            ESPACE DE GESTION
            <strong>Restaurant Management</strong>
        </div>

        <div class="topbar-user">
            <div class="user-avatar">
                <i class="bi bi-person"></i>
            </div>
            <span>Administration</span>
        </div>

    </header>

    <main class="content-area">
        {% block body %}{% endblock %}
    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
