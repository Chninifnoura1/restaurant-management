{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .dish-form-page {
            max-width: 1100px;
            margin: 0 auto;
        }

        .form-page-header {
            margin-bottom: 25px;
        }

        .form-page-header h1 {
            font-size: 27px;
            font-weight: 750;
            color: #172033;
            margin-bottom: 6px;
        }

        .form-page-header p {
            color: #7b8495;
            margin: 0;
        }

        .form-card {
            background: white;
            border: 1px solid #e8edf3;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
            overflow: hidden;
            margin-bottom: 22px;
        }

        .form-card-header {
            padding: 19px 23px;
            border-bottom: 1px solid #edf0f5;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .form-card-header h2 {
            font-size: 17px;
            font-weight: 700;
            color: #172033;
            margin: 0;
        }

        .form-icon {
            width: 39px;
            height: 39px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: #2563eb;
            border-radius: 10px;
            font-size: 18px;
        }

        .form-card-body {
            padding: 25px;
        }

        .form-card-body label {
            font-weight: 600;
            font-size: 13px;
            color: #475569;
            margin-bottom: 8px;
        }

        .form-card-body .form-control,
        .form-card-body .form-select {
            border: 1px solid #dfe5ed;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 14px;
            min-height: 43px;
        }

        .form-card-body .form-control:focus,
        .form-card-body .form-select:focus {
            border-color: #93b4f5;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
        }

        .form-card-body textarea.form-control {
            min-height: 100px;
        }

        .form-card-body .form-check {
            padding: 12px 14px 12px 38px;
            background: #f8fafc;
            border: 1px solid #e8edf3;
            border-radius: 8px;
            min-height: 43px;
        }

        .form-card-body .form-check-input {
            margin-top: 4px;
        }

        .recipe-description {
            color: #7b8495;
            font-size: 13px;
            margin: 0 0 20px;
        }

        .recipe-item {
            background: #f8fafc;
            border: 1px solid #e5eaf1 !important;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 13px;
        }

        .recipe-item label {
            display: block;
            font-weight: 600;
            color: #475569;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .recipe-item .form-control,
        .recipe-item .form-select {
            border-radius: 8px;
            min-height: 42px;
        }

        .recipe-item .remove-recipe {
            margin-top: 12px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
        }

        .add-recipe-btn {
            background: #eff6ff;
            color: #2563eb;
            border: 1px dashed #93b4f5;
            border-radius: 8px;
            padding: 10px 15px;
            font-size: 13px;
            font-weight: 700;
        }

        .add-recipe-btn:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
            padding: 20px 0 35px;
        }

        .form-actions .btn {
            border-radius: 8px;
            padding: 10px 19px;
            font-weight: 600;
            font-size: 13px;
        }

        .save-btn {
            background: #2563eb;
            border: none;
            color: white;
        }

        .save-btn:hover {
            background: #1d4ed8;
            color: white;
        }

        @media (max-width: 768px) {
            .form-card-body {
                padding: 18px;
            }

            .form-page-header h1 {
                font-size: 22px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid py-3 dish-form-page">

    <div class="form-page-header">
        <h1>{{ title }}</h1>
        <p>Renseignez les informations du plat et définissez sa recette.</p>
    </div>

    {{ form_start(form) }}

    <div class="form-card">
        <div class="form-card-header">
            <div class="form-icon">
                <i class="bi bi-info-circle"></i>
            </div>
            <div>
                <h2>Informations générales</h2>
                <small class="text-muted">Informations principales du plat</small>
            </div>
        </div>

        <div class="form-card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_row(form.name) }}
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_row(form.category) }}
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_row(form.salePrice) }}
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_row(form.isAvailable) }}
                </div>

                <div class="col-12 mb-2">
                    {{ form_row(form.description) }}
                </div>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <div class="form-icon">
                <i class="bi bi-list-check"></i>
            </div>
            <div>
                <h2>Composition de la recette</h2>
                <small class="text-muted">Ingrédients nécessaires pour préparer une portion</small>
            </div>
        </div>

        <div class="form-card-body">
            <p class="recipe-description">
                Ajoutez chaque ingrédient et indiquez la quantité nécessaire pour une portion du plat.
            </p>

            <div id="recipe-list"
                 data-index="{{ form.ingredients|length }}"
                 data-prototype="{{ form_widget(form.ingredients.vars.prototype)|e('html_attr') }}">

                {% for recipe in form.ingredients %}
                    <div class="recipe-item">
                        {{ form_errors(recipe) }}

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(recipe.ingredient) }}
                            </div>

                            <div class="col-md-6">
                                {{ form_row(recipe.quantity) }}
                            </div>
                        </div>

                        <button type="button" class="btn btn-outline-danger btn-sm remove-recipe">
                            <i class="bi bi-trash me-1"></i>
                            Supprimer cet ingrédient
                        </button>
                    </div>
                {% endfor %}
            </div>

            <button type="button" id="add-recipe" class="add-recipe-btn">
                <i class="bi bi-plus-circle me-1"></i>
                Ajouter un ingrédient
            </button>
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ path('app_dish_index') }}" class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i>
            Annuler
        </a>

        <button type="submit" class="btn save-btn">
            <i class="bi bi-check-circle me-1"></i>
            Enregistrer le plat
        </button>
    </div>

    {{ form_end(form) }}

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const list = document.getElementById('recipe-list');
    const addButton = document.getElementById('add-recipe');

    function addRecipe() {
        const index = Number(list.dataset.index);
        const prototype = list.dataset.prototype.replace(/__name__/g, index);

        const wrapper = document.createElement('div');
        wrapper.className = 'recipe-item';

        wrapper.innerHTML = `
            ${prototype}
            <button type="button" class="btn btn-outline-danger btn-sm remove-recipe">
                <i class="bi bi-trash me-1"></i>
                Supprimer cet ingrédient
            </button>
        `;

        list.appendChild(wrapper);
        list.dataset.index = index + 1;
    }

    addButton.addEventListener('click', addRecipe);

    list.addEventListener('click', function (event) {
        const removeButton = event.target.closest('.remove-recipe');

        if (removeButton) {
            removeButton.closest('.recipe-item').remove();
        }
    });
});
</script>
{% endblock %}
